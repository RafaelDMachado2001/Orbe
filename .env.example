# ---------------------------------------------------------------------------
# Orquestracao Docker + variaveis de ambiente da API.
# Estas variaveis sao injetadas nos containers PHP e tem precedencia sobre o
# backend/.env, entao este arquivo e a fonte unica de verdade para credenciais.
# ---------------------------------------------------------------------------

# Usuario do host, usado para evitar arquivos criados como root no bind mount.
UID=1000
GID=1000

APP_NAME="Verso Financas"
APP_ENV=local
APP_DEBUG=true
APP_TIMEZONE=America/Sao_Paulo
APP_URL=http://localhost:8000
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

FRONTEND_URL=http://localhost:5173

# Portas publicadas no host.
API_FORWARD_PORT=8000
WEB_FORWARD_PORT=5173
DB_FORWARD_PORT=5433
REDIS_FORWARD_PORT=6380

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=verso_financas
DB_USERNAME=verso
DB_PASSWORD=secret

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_CLIENT=phpredis

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

LOG_CHANNEL=stack
LOG_LEVEL=debug

MAIL_MAILER=log

# Roda o seeder de demonstracao no primeiro boot do container api.
DB_SEED_ON_BOOT=true

# URL da API consumida pelo frontend React.
VITE_API_URL=http://localhost:8000/api/v1
